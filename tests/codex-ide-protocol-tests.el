;;; codex-ide-protocol-tests.el --- Pagination tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'codex-ide)

(ert-deftest codex-ide-protocol-all-threads-pages-global-and-sources ()
  (let ((session (make-codex-ide-session :directory "/project/")) requests)
    (cl-letf (((symbol-function 'codex-ide--request-sync)
               (lambda (_ method params)
                 (should (equal method "thread/list"))
                 (push params requests)
                 (if (alist-get 'cursor params)
                     '((data . (((id . "two")))))
                   '((data . [((id . "one"))]) (nextCursor . "page2"))))))
      (should (equal (mapcar (lambda (x) (alist-get 'id x))
                            (codex-ide--list-all-threads session :directory nil :archived nil))
                     '("one" "two")))
      (should (= (length requests) 2))
      (dolist (params requests)
        (should-not (assq 'cwd params))
        (should (eq (alist-get 'archived params) :json-false))
        (dolist (source '("cli" "appServer" "exec" "subAgentThreadSpawn" "unknown"))
          (should (seq-contains-p (alist-get 'sourceKinds params) source)))))))

(ert-deftest codex-ide-protocol-all-threads-project-archive-and-empty-page ()
  (let ((calls 0))
    (cl-letf (((symbol-function 'codex-ide--request-sync)
               (lambda (_ _ params)
                 (cl-incf calls)
                 (should (equal (alist-get 'cwd params) "/project/"))
                 (should (eq (alist-get 'archived params) t))
                 (if (= calls 1) '((data . []) (nextCursor . "next"))
                   '((data . [((id . "last"))]))))))
      (should (= (length (codex-ide--list-all-threads
                         'session :directory "/project/" :archived t)) 1))
      (should (= calls 2)))))

(ert-deftest codex-ide-protocol-pagination-refuses-loops-and-errors ()
  (cl-letf (((symbol-function 'codex-ide--request-sync)
             (lambda (&rest _) '((data . []) (nextCursor . "loop")))))
    (should-error (codex-ide--list-all-threads 'session)))
  (cl-letf (((symbol-function 'codex-ide--request-sync)
             (lambda (&rest _) (error "Server unavailable"))))
    (should-error (codex-ide--list-all-threads 'session))))

(ert-deftest codex-ide-protocol-list-threads-backward-directory-and-options ()
  (let ((session (make-codex-ide-session :directory "/project/")) calls)
    (cl-letf (((symbol-function 'codex-ide--request-sync)
               (lambda (_ _ params) (push params calls) '((data . [((id . "id"))])))))
      (should (= (length (codex-ide--list-threads session :limit 12 :sort-key "created_at")) 1))
      (should (equal (alist-get 'cwd (car calls)) "/project/"))
      (should (= (alist-get 'limit (car calls)) 12))
      (should (equal (alist-get 'sortKey (car calls)) "created_at"))
      (codex-ide--list-threads session :directory nil :archived t :cursor "next")
      (should-not (assq 'cwd (car calls)))
      (should (eq (alist-get 'archived (car calls)) t))
      (should (equal (alist-get 'cursor (car calls)) "next")))))

(ert-deftest codex-ide-protocol-archive-rpc-shapes ()
  (let (calls)
    (cl-letf (((symbol-function 'codex-ide--request-sync)
               (lambda (session method params)
                 (push (list session method params) calls))))
      (codex-ide--archive-thread 'session "id")
      (codex-ide--unarchive-thread 'session "id")
      (should (equal (nreverse calls)
                     '((session "thread/archive" ((threadId . "id")))
                       (session "thread/unarchive" ((threadId . "id")))))))))
(provide 'codex-ide-protocol-tests)
