;;; codex-ide-archive-tests.el --- Archive command tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'codex-ide-archive)

(ert-deftest codex-ide-archive-confirmation-and-failure-preserve-session ()
  (let ((session (make-codex-ide-session :thread-id "id")) called detached)
    (cl-letf (((symbol-function 'codex-ide-archive--connection) (lambda () session))
              ((symbol-function 'codex-ide--session-buffer-sessions) (lambda () (list session)))
              ((symbol-function 'yes-or-no-p) (lambda (text)
                                                    (should (string-match-p "descendants" text)) nil))
              ((symbol-function 'codex-ide--archive-thread) (lambda (&rest _) (setq called t)))
              ((symbol-function 'codex-ide-archive--detach) (lambda (_) (setq detached t))))
      (should-error (codex-ide-archive-thread "id") :type 'user-error)
      (should-not called)
      (cl-letf (((symbol-function 'yes-or-no-p) (lambda (_) t))
                ((symbol-function 'codex-ide-archive--guard) #'ignore)
                ((symbol-function 'codex-ide--archive-thread) (lambda (&rest _) (error "RPC failed"))))
        (should-error (codex-ide-archive-thread "id")))
      (should-not detached)
      (should (equal (codex-ide-session-thread-id session) "id")))))

(ert-deftest codex-ide-archive-guards-local-and-remote-turns ()
  (let ((session (make-codex-ide-session :status "submitted")) read)
    (cl-letf (((symbol-function 'codex-ide--session-buffer-sessions) (lambda () (list session)))
              ((symbol-function 'codex-ide--request-sync)
               (lambda (&rest _) (setq read t) '((thread . ((status . ((type . "active")))))))))
      (should-error (codex-ide-archive--guard session "id") :type 'user-error)
      (should-not read)
      (setf (codex-ide-session-status session) "idle")
      (should-error (codex-ide-archive--guard session "id") :type 'user-error)
      (should read)
      (cl-letf (((symbol-function 'codex-ide--request-sync)
                 (lambda (&rest _) '((thread . ((status . ((type . "idle")))))))))
        (codex-ide-archive--guard session "id")))))

(ert-deftest codex-ide-archive-success-detaches-target-and-descendants ()
  (let* ((target (make-codex-ide-session :thread-id "parent"))
         (child (make-codex-ide-session :thread-id "child"))
         (other (make-codex-ide-session :thread-id "other")) detached archived)
    (cl-letf (((symbol-function 'codex-ide-archive--connection) (lambda () target))
              ((symbol-function 'codex-ide--session-buffer-sessions) (lambda () (list target child other)))
              ((symbol-function 'yes-or-no-p) (lambda (_) t))
              ((symbol-function 'codex-ide-archive--guard) #'ignore)
              ((symbol-function 'codex-ide--archive-thread) (lambda (&rest _) (setq archived t)))
              ((symbol-function 'codex-ide--list-all-threads)
               (lambda (_ &rest _) (should archived) '(((id . "parent")) ((id . "child")))))
              ((symbol-function 'codex-ide-archive--detach) (lambda (session) (push session detached))))
      (codex-ide-archive-thread "parent")
      (should (equal detached (list child target))))))

(ert-deftest codex-ide-archive-detach-stops-before-clearing-identity ()
  (let* ((buffer (generate-new-buffer " *archive-test*"))
         (session (make-codex-ide-session :thread-id "id" :buffer buffer)))
    (unwind-protect
        (cl-letf (((symbol-function 'codex-ide--teardown-session)
                   (lambda (s &optional _) (should (equal (codex-ide-session-thread-id s) "id")))))
          (codex-ide-archive--detach session)
          (should-not (codex-ide-session-thread-id session))
          (should-not (buffer-live-p buffer)))
      (when (buffer-live-p buffer) (kill-buffer buffer)))))

(ert-deftest codex-ide-archive-refresh-fetches-scope-and-toggle ()
  (with-temp-buffer
    (codex-ide-thread-list-mode)
    (setq-local codex-ide-archive--directory "/project/" codex-ide-archive--archived t)
    (let (calls)
      (cl-letf (((symbol-function 'codex-ide-archive--connection) (lambda () 'session))
                ((symbol-function 'codex-ide--list-all-threads)
                 (lambda (_ &rest args) (push args calls) '(((id . "id") (cwd . "/else/"))))))
        (codex-ide-archive--entries)
        (should (equal (car calls) '(:directory "/project/" :archived t)))
        (cl-letf (((symbol-function 'revert-buffer) (lambda (&rest _) (codex-ide-archive--entries))))
          (codex-ide-thread-list-toggle-archived))
        (should (equal (car calls) '(:directory "/project/" :archived nil)))
        (cl-letf (((symbol-function 'codex-ide--show-or-resume-thread)
                   (lambda (id directory) (should (equal id "id")) (should (equal directory "/else/")))))
          (codex-ide-archive--visit "id"))))))

(ert-deftest codex-ide-archive-restore-does-not-resume ()
  (let (restored)
    (cl-letf (((symbol-function 'codex-ide-archive--connection) (lambda () 'session))
              ((symbol-function 'codex-ide--unarchive-thread)
               (lambda (s id) (setq restored (list s id))))
              ((symbol-function 'codex-ide--show-or-resume-thread) (lambda (&rest _) (ert-fail "Unexpected resume"))))
      (codex-ide-unarchive-thread "id")
      (should (equal restored '(session "id"))))))
(ert-deftest codex-ide-archive-empty-list-does-not-fall-back-to-session ()
  (with-temp-buffer
    (codex-ide-thread-list-mode)
    (cl-letf (((symbol-function 'codex-ide--get-default-session-for-current-buffer)
               (lambda () (ert-fail "Unexpected session fallback"))))
      (should-error (codex-ide-archive--thread-id) :type 'user-error))))

(ert-deftest codex-ide-archive-toggle-rolls-back-failed-refresh ()
  (dolist (state '(nil t))
    (with-temp-buffer
      (codex-ide-thread-list-mode)
      (setq codex-ide-archive--archived state header-line-format "original")
      (cl-letf (((symbol-function 'revert-buffer) (lambda (&rest _) (error "Page failed"))))
        (should-error (codex-ide-thread-list-toggle-archived))
        (should (eq codex-ide-archive--archived state))
        (should (equal header-line-format "original"))))))

(ert-deftest codex-ide-archive-enumeration-failure-detaches-conservatively ()
  (let* ((one (make-codex-ide-session :thread-id "one"))
         (two (make-codex-ide-session :thread-id "two")) detached)
    (cl-letf (((symbol-function 'codex-ide--list-all-threads)
               (lambda (&rest _) (error "Refresh failed")))
              ((symbol-function 'codex-ide-archive--detach)
               (lambda (session) (push session detached))))
      (codex-ide-archive--detach-archived 'connection "one" (list one two))
      (should (equal detached (list two one))))))

(ert-deftest codex-ide-archive-initializes-query-connection-on-demand ()
  (let ((codex-ide--sessions nil)
        (codex-ide-archive--session nil)
        prepared)
    (cl-letf (((symbol-function 'codex-ide--get-default-session-for-current-buffer)
               (lambda () nil))
              ((symbol-function 'codex-ide--prepare-session-operations)
               (lambda () (setq prepared t)))
              ((symbol-function 'codex-ide--ensure-query-session-for-thread-selection)
               (lambda () 'query-session)))
      (should (eq (codex-ide-archive--connection) 'query-session))
      (should prepared))))

(ert-deftest codex-ide-archive-enumeration-quit-detaches-before-propagating ()
  (let* ((one (make-codex-ide-session :thread-id "one"))
         (two (make-codex-ide-session :thread-id "child"))
         detached cancelled)
    (cl-letf (((symbol-function 'codex-ide--list-all-threads)
               (lambda (&rest _) (signal 'quit nil)))
              ((symbol-function 'codex-ide-archive--detach)
               (lambda (session)
                 (push session detached)
                 (setf (codex-ide-session-thread-id session) nil))))
      (condition-case nil
          (codex-ide-archive--detach-archived 'connection "one" (list one two))
        (quit (setq cancelled t)))
      (should cancelled)
      (should (equal detached (list two one)))
      (should-not (codex-ide-session-thread-id one))
      (should-not (codex-ide-session-thread-id two)))))

(ert-deftest codex-ide-archive-never-reuses-a-mismatched-private-connection ()
  (let ((codex-ide--sessions '(private))
        (codex-ide-archive--session 'private))
    (cl-letf (((symbol-function 'codex-ide--live-session-p) (lambda (_) t))
              ((symbol-function 'codex-ide--session-uses-configured-transport-p)
               (lambda (_) nil))
              ((symbol-function 'codex-ide--get-default-session-for-current-buffer)
               (lambda () 'private))
              ((symbol-function 'codex-ide--prepare-session-operations) #'ignore)
              ((symbol-function 'codex-ide--ensure-query-session-for-thread-selection)
               (lambda () 'shared)))
      (should (eq (codex-ide-archive--connection) 'shared)))))

(provide 'codex-ide-archive-tests)
