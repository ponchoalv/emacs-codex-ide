;;; codex-ide-search-tests.el --- Stored message search tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'codex-ide-search)
(defvar consult--completion-candidate-hook)

(defun codex-ide-search-test--read (items)
  "Wrap ITEMS in a stored thread response."
  `((thread . ((turns . [((items . ,items))])))))

(ert-deftest codex-ide-search-extracts-full-message-arrays ()
  (should
   (equal
    (codex-ide-search--messages
     (codex-ide-search-test--read
      [((type . "userMessage")
        (content . [((type . "text") (text . "first"))
                    ((type . "image") (url . "not text"))
                    ((type . "text") (text . "second"))]))
       ((type . "agentMessage") (text . "assistant full text"))
       ((type . "commandExecution") (text . "ignore tool"))
       ((role . "assistant") (content . [((text . "also assistant"))]))]))
    '((user . "first\nsecond")
      (assistant . "assistant full text")
      (assistant . "also assistant")))))

(ert-deftest codex-ide-search-scopes-and-reads-all-turns ()
  (let (scopes reads)
    (cl-letf (((symbol-function 'codex-ide--list-all-threads)
               (lambda (_session &rest args)
                 (push args scopes)
                 ;; Represents the protocol helper's complete multi-page list.
                 '(((id . "closed-first-page") (cwd . "/one/"))
                   ((id . "closed-last-page") (cwd . "/two/")))))
              ((symbol-function 'codex-ide--read-thread)
               (lambda (_session id include-turns)
                 (push (list id include-turns) reads)
                 `((thread . ((turns . ,(vconcat
                                        (make-list 101 '((items . [])))
                                        [((items . [((type . "agentMessage")
                                                     (text . "late NEEDLE"))]))]))))))))
      (dolist (directory '(nil "/project/"))
        (let ((result (codex-ide-search--scan nil "needle" :directory directory)))
          (should (= 2 (length (plist-get result :hits))))
          (should-not (plist-get result :errors))))
      (should (equal scopes '((:directory "/project/" :archived nil)
                              (:directory nil :archived nil))))
      (should (= 4 (length reads)))
      (should (cl-every #'cadr reads)))))

(ert-deftest codex-ide-search-literal-case-insensitive-and-repeated ()
  (cl-letf (((symbol-function 'codex-ide--list-all-threads)
             (lambda (&rest _) '(((id . "a") (cwd . "/a/")))) )
            ((symbol-function 'codex-ide--read-thread)
             (lambda (&rest _)
               (codex-ide-search-test--read
                [((type . "userMessage") (text . "xx A.*[B] yy a.*[b]"))]))))
    (let* ((result (codex-ide-search--scan
                    nil "a.*[b]"
                    ;; Reporting may use regexps and overwrite match data.
                    :report (lambda (_) (string-match "z" "z"))))
           (hits (plist-get result :hits)))
      (should (= 2 (length hits)))
      (should (equal (mapcar #'codex-ide-search--hit-offset hits) '(3 13))))))

(ert-deftest codex-ide-search-errors-are-visible-and-do-not-skip-other-threads ()
  (let (reported)
    (cl-letf (((symbol-function 'codex-ide--list-all-threads)
               (lambda (&rest _) '(((id . "broken")) ((id . "good") (cwd . "/good/")))))
              ((symbol-function 'codex-ide--read-thread)
               (lambda (_session id _turns)
                 (if (equal id "broken") (error "Unreadable history")
                   (codex-ide-search-test--read
                    [((type . "agentMessage") (text . "match"))])))))
      (let ((result (codex-ide-search--scan
                     nil "match" :report (lambda (x) (push x reported)))))
        (should (= 1 (length (plist-get result :hits))))
        (should (string-match-p "broken.*Unreadable history"
                                (car (plist-get result :errors))))
        (with-temp-buffer
          (codex-ide-search-mode)
          (mapc #'codex-ide-search--insert-result (reverse reported))
          (should (string-match-p "ERROR: Thread broken" (buffer-string)))
          (should (string-match-p "good" (buffer-string))))))))

(ert-deftest codex-ide-search-cancellation-retains-partial-results ()
  (cl-letf (((symbol-function 'codex-ide--list-all-threads)
             (lambda (&rest _) '(((id . "one") (cwd . "/one/")) ((id . "two")))))
            ((symbol-function 'codex-ide--read-thread)
             (lambda (_session id _turns)
               (if (equal id "two") (signal 'quit nil)
                 (codex-ide-search-test--read
                  [((type . "userMessage") (text . "match"))])))))
    (let ((result (codex-ide-search--scan nil "match")))
      (should (plist-get result :cancelled))
      (should (= 1 (length (plist-get result :hits))))
      (should-not (plist-get result :errors)))))

(ert-deftest codex-ide-search-preview-jumps-exact-message-and-resumes-only-on-request ()
  (let* ((messages (append (make-list 102 '(user . "same match"))
                           '((assistant . "prefix MATCH suffix"))))
         (hit (codex-ide-search--make-hit
               :thread '((id . "preview-test")) :directory "/project/"
               :messages messages :message-index 102 :offset 7 :query "match"))
         resumed)
    (unwind-protect
        (cl-letf (((symbol-function 'pop-to-buffer) (lambda (buffer &rest _) (set-buffer buffer)))
                  ((symbol-function 'codex-ide--show-or-resume-thread)
                   (lambda (&rest args) (setq resumed args)))
                  ;; No server/module loading is needed for the resume dispatch test.
                  ((symbol-function 'require)
                   (let ((original (symbol-function 'require)))
                     (lambda (feature &rest args)
                       (unless (eq feature 'codex-ide-session)
                         (apply original feature args))))))
          (with-temp-buffer
            (codex-ide-search-mode)
            (codex-ide-search--insert-result hit)
            (goto-char (point-min))
            (save-current-buffer
              (codex-ide-search-preview)
              (should (derived-mode-p 'codex-ide-search-preview-mode))
              (should buffer-read-only)
              (should (looking-at "MATCH suffix"))
              (should (= 103 (length codex-ide-search--message-starts)))
              (should-not resumed)
              (codex-ide-search-resume)
              (should (equal resumed '("preview-test" "/project/"))))))
      (when (get-buffer "*Codex preview: preview-test*")
        (kill-buffer "*Codex preview: preview-test*")))))

(ert-deftest codex-ide-search-does-not-search-titles-or-truncate-message-content ()
  (let ((long-text (concat (make-string 50000 ?x) "Needle")))
    (cl-letf (((symbol-function 'codex-ide--list-all-threads)
               (lambda (&rest _)
                 '(((id . "title-only") (preview . "needle") (cwd . "/a/"))
                   ((id . "content") (cwd . "/b/")))))
              ((symbol-function 'codex-ide--read-thread)
               (lambda (_session id _turns)
                 (codex-ide-search-test--read
                  (vector `((type . "userMessage")
                            (content . [((type . "text")
                                         (text . ,(if (equal id "content")
                                                      long-text "no match")))])))))))
      (let* ((result (codex-ide-search--scan nil "needle"))
             (hits (plist-get result :hits)))
        (should (= 1 (length hits)))
        (should (= 50000 (codex-ide-search--hit-offset (car hits))))
        (should (equal long-text (cdar (codex-ide-search--hit-messages (car hits)))))))))

(ert-deftest codex-ide-search-empty-query-rejected-before-rpc ()
  (cl-letf (((symbol-function 'codex-ide--list-all-threads)
             (lambda (&rest _) (ert-fail "Unexpected RPC"))))
    (should-error (codex-ide-search--scan nil "") :type 'user-error)))

(ert-deftest codex-ide-search-public-scope-commands ()
  (let (calls)
    (cl-letf (((symbol-function 'codex-ide--get-working-directory) (lambda () "/project/"))
              ((symbol-function 'codex-ide-search--run)
               (lambda (&rest args) (push args calls))))
      (codex-ide-search-threads "global")
      (codex-ide-search-project-threads "local")
      (should (equal calls '(("local" "/project/") ("global" nil)))))))

(defun codex-ide-search-test--hit (&optional text index)
  "Return a stored message hit with optional TEXT and INDEX."
  (codex-ide-search--make-hit
   :thread '((id . "completion-test") (name . "A chat"))
   :directory "/project/" :messages (list (cons 'assistant (or text "a needle b needle")))
   :message-index 0 :offset (or index 2) :query "needle"))

(ert-deftest codex-ide-search-collects-messages-without-literal-prefilter ()
  (cl-letf (((symbol-function 'codex-ide--list-all-threads)
             (lambda (_session &rest options)
               (should (equal options '(:directory "/project/" :archived nil)))
               '(((id . "a") (cwd . "/project/")))))
            ((symbol-function 'codex-ide--read-thread)
             (lambda (_session _id turns)
               (should turns)
               (codex-ide-search-test--read
                [((type . "userMessage") (text . "alpha"))
                 ((type . "agentMessage") (text . "omega"))]))))
    (let ((hits (plist-get (codex-ide-search--scan nil nil :directory "/project/") :hits)))
      (should (= (length hits) 2))
      (should (equal (mapcar #'codex-ide-search--hit-message-index hits) '(0 1))))))

(ert-deftest codex-ide-search-full-message-candidates-are-unique-and-fuzzy ()
  (let* ((hit (codex-ide-search-test--hit
               (concat (make-string 1000 ?x) "\nQ prose 7 prose r prose 9")))
         (candidates (codex-ide-search--candidates (list hit hit)))
         (completion-styles '(flex))
         (completion-category-defaults nil)
         (completion-category-overrides nil))
    (should (= 2 (length (delete-dups (mapcar #'car candidates)))))
    (should (eq hit (cdar candidates)))
    (should-not (string-match-p "\n" (caar candidates)))
    (should (string-match-p "Q prose 7 prose r prose 9" (caar candidates)))
    (should (completion-all-completions "Q7r9" (mapcar #'car candidates) nil 4))))

(ert-deftest codex-ide-search-consult-contract-respects-completion-and-preview-settings ()
  (let ((completion-styles '(basic))
        (completion-category-defaults '((file (styles partial-completion))))
        (completion-category-overrides '((codex-ide-message (styles flex))))
        (hit (codex-ide-search-test--hit)))
    (cl-letf (((symbol-function 'consult--state-with-return) (lambda (&rest _) #'ignore))
              ((symbol-function 'consult--read)
               (lambda (table &rest options)
                 (should (eq (plist-get options :category) 'codex-ide-message))
                 (should (plist-get options :require-match))
                 (should-not (plist-member options :preview-key))
                 (should (equal (alist-get 'styles
                                           (alist-get 'codex-ide-message completion-category-defaults))
                                '(basic flex)))
                 (should (equal completion-category-overrides
                                '((codex-ide-message (styles flex)))))
                 (should (eq hit (funcall (plist-get options :lookup) (car table)))))))
      (codex-ide-search--consult-read (list hit) nil 0))))

(ert-deftest codex-ide-search-consult-preserves-explicit-category-defaults ()
  (let ((completion-category-defaults '((codex-ide-message (styles basic)))))
    (cl-letf (((symbol-function 'consult--state-with-return) (lambda (&rest _) #'ignore))
              ((symbol-function 'consult--read)
               (lambda (&rest _)
                 (should (equal completion-category-defaults
                                '((codex-ide-message (styles basic))))))))
      (codex-ide-search--consult-read (list (codex-ide-search-test--hit)) nil 0))))

(defun codex-ide-search-test--compose-state (state return)
  "Compose STATE and RETURN like Consult's state adapter."
  (lambda (action candidate)
    (funcall state action candidate)
    (when (and candidate (eq action 'return)) (funcall return candidate))))

(ert-deftest codex-ide-search-consult-abort-restores-window-and-cleans-preview ()
  (save-window-excursion
    (let ((origin (window-buffer)) preview)
      (cl-letf (((symbol-function 'consult--state-with-return)
                 #'codex-ide-search-test--compose-state)
                ((symbol-function 'consult--read)
                 (lambda (table &rest options)
                   (let* ((hit (funcall (plist-get options :lookup) (car table)))
                          (state (plist-get options :state)))
                     (funcall state 'preview hit)
                     (setq preview (current-buffer))
                     (should (derived-mode-p 'codex-ide-search-preview-mode))
                     (funcall state 'exit nil)
                     (signal 'quit nil)))))
        (should (condition-case nil
                    (progn (codex-ide-search--consult-read
                            (list (codex-ide-search-test--hit)) nil 0)
                           nil)
                  (quit t))))
      (should (eq (window-buffer) origin))
      (should-not (buffer-live-p preview)))))

(ert-deftest codex-ide-search-consult-reuses-preview-and-keeps-final-selection ()
  (save-window-excursion
    (let ((first (codex-ide-search-test--hit))
          (second (codex-ide-search-test--hit nil 11))
          preview)
      (unwind-protect
          (cl-letf (((symbol-function 'consult--state-with-return)
                     #'codex-ide-search-test--compose-state)
                    ((symbol-function 'consult--read)
                     (lambda (_table &rest options)
                       (let ((state (plist-get options :state)))
                         (funcall state 'preview first)
                         (setq preview (current-buffer))
                         (funcall state 'preview second)
                         (should (eq preview (current-buffer)))
                         (funcall state 'exit nil)
                         (funcall state 'return second)
                         second))))
            (codex-ide-search--consult-read (list first second) nil 0)
            (should (buffer-live-p preview))
            (should (eq (window-buffer) preview))
            (with-current-buffer preview
              (should (eq codex-ide-search--preview-hit second))
              (should (looking-at "needle"))))
        (when (buffer-live-p preview) (kill-buffer preview))))))

(ert-deftest codex-ide-search-optional-consult-and-literal-fallback ()
  (let ((original-require (symbol-function 'require)) calls available)
    (cl-letf (((symbol-function 'require)
               (lambda (feature &rest args)
                 (if (eq feature 'consult) available
                   (apply original-require feature args))))
              ((symbol-function 'read-string) (lambda (&rest _) "literal"))
              ((symbol-function 'codex-ide-search--run)
               (lambda (&rest args) (push (cons 'literal args) calls)))
              ((symbol-function 'codex-ide-search--live)
               (lambda (&rest args) (push (cons 'consult args) calls))))
      (codex-ide-search--dispatch nil nil)
      (setq available t)
      (codex-ide-search--dispatch nil "/project/")
      (codex-ide-search--dispatch "explicit" nil)
      (should (equal (reverse calls) '((literal "literal" nil)
                                       (consult "/project/")
                                       (literal "explicit" nil)))))))

(ert-deftest codex-ide-search-results-inherit-occur-conventions ()
  (with-temp-buffer
    (codex-ide-search-mode)
    (should (derived-mode-p 'occur-mode))
    (should (eq next-error-function #'occur-next-error))
    (dolist (binding '(("RET" . occur-mode-goto-occurrence)
                       ("o" . occur-mode-goto-occurrence-other-window)
                       ("C-o" . occur-mode-display-occurrence)
                       ("n" . next-error-no-select)
                       ("p" . previous-error-no-select)
                       ("r" . rename-buffer)))
      (should (eq (key-binding (kbd (car binding))) (cdr binding))))
    (should (eq (key-binding (kbd "C-c C-r")) #'codex-ide-search-resume))
    (should-error (call-interactively (key-binding (kbd "e"))) :type 'user-error)))

(ert-deftest codex-ide-search-occur-targets-share-snapshot-and-visit-exact-offsets ()
  (save-window-excursion
    (with-temp-buffer
      (codex-ide-search-mode)
      (let ((inhibit-read-only t)) (insert "Results\n\n"))
      (codex-ide-search--insert-result (codex-ide-search-test--hit))
      (codex-ide-search--insert-result (codex-ide-search-test--hit nil 11))
      (let ((results (current-buffer)) first-marker second-marker)
        (goto-char (point-min))
        (occur-next)
        (setq first-marker (occur-mode-find-occurrence))
        (should (with-current-buffer (marker-buffer first-marker)
                  (goto-char first-marker) (looking-at "needle")))
        (occur-next)
        (setq second-marker (occur-mode-find-occurrence))
        (should (eq (marker-buffer first-marker) (marker-buffer second-marker)))
        (should (= (- second-marker first-marker) 9))
        (let ((next-error-highlight nil))
          (occur-next-error 1 t)
          (should (looking-at "needle"))
          (should (= (point) first-marker)))
        (set-buffer results)
        (should (= 1 (length codex-ide-search--source-buffers)))))))

(ert-deftest codex-ide-search-results-revert-repeats-original-scope ()
  (with-temp-buffer
    (codex-ide-search-mode)
    (setq codex-ide-search--query "needle" codex-ide-search--directory "/project/")
    (cl-letf (((symbol-function 'codex-ide-search--run)
               (lambda (query directory buffer)
                 (should (equal query "needle"))
                 (should (equal directory "/project/"))
                 (should (eq buffer (current-buffer))))))
      (funcall revert-buffer-function nil t))))

(ert-deftest codex-ide-search-prefix-selects-occur-even-with-consult ()
  (let ((current-prefix-arg '(4)) calls)
    (cl-letf (((symbol-function 'read-string) (lambda (&rest _) "literal"))
              ((symbol-function 'codex-ide--get-working-directory) (lambda () "/project/"))
              ((symbol-function 'codex-ide-search--dispatch)
               (lambda (&rest args) (push args calls))))
      (call-interactively #'codex-ide-search-threads)
      (call-interactively #'codex-ide-search-project-threads)
      (should (equal calls '(("literal" "/project/") ("literal" nil)))))))

(ert-deftest codex-ide-search-live-scan-cancellation-retains-occur-results ()
  (let ((original-require (symbol-function 'require)))
    (unwind-protect
        (cl-letf (((symbol-function 'require)
                   (lambda (feature &rest args)
                     (unless (eq feature 'codex-ide-session)
                       (apply original-require feature args))))
                  ((symbol-function 'codex-ide--prepare-session-operations) #'ignore)
                  ((symbol-function 'codex-ide--ensure-query-session-for-thread-selection) #'ignore)
                  ((symbol-function 'codex-ide-search--scan)
                   (lambda (&rest _)
                     (list :hits (list (codex-ide-search-test--hit)) :cancelled t)))
                  ((symbol-function 'pop-to-buffer) #'ignore)
                  ((symbol-function 'codex-ide-search--consult-read)
                   (lambda (&rest _) (ert-fail "Completion after cancelled scan"))))
          (should (condition-case nil
                      (progn (codex-ide-search--live nil) nil)
                    (quit t)))
          (with-current-buffer "*Codex search*"
            (should (derived-mode-p 'occur-mode))
            (should (string-match-p "CANCELLED (partial results)" (buffer-string)))
            (goto-char (point-min))
            (occur-next)
            (should (marker-buffer (occur-mode-find-occurrence)))))
      (when (get-buffer "*Codex search*") (kill-buffer "*Codex search*")))))

(ert-deftest codex-ide-search-standard-next-error-traverses-snapshots ()
  (save-window-excursion
    (let ((results (generate-new-buffer " *Codex navigation test*")) source)
      (unwind-protect
          (progn
            (switch-to-buffer results)
            (codex-ide-search-mode)
            (let ((inhibit-read-only t)) (insert "Results\n\n"))
            (codex-ide-search--insert-result (codex-ide-search-test--hit))
            (codex-ide-search--insert-result (codex-ide-search-test--hit nil 11))
            (setq source (cdar codex-ide-search--source-buffers))
            (let ((next-error-last-buffer results) (next-error-highlight nil) first)
              (next-error 1 t)
              ;; The command loop normally synchronizes the current buffer
              ;; with the selected window after next-error's save-current-buffer.
              (set-buffer (window-buffer))
              (should (eq (current-buffer) source))
              (should (looking-at "needle"))
              (setq first (point))
              (next-error 1)
              (set-buffer (window-buffer))
              (should (= (point) (+ first 9)))
              (previous-error 1)
              (set-buffer (window-buffer))
              (should (= (point) first))))
        (when (buffer-live-p results) (kill-buffer results))
        (when (buffer-live-p source) (kill-buffer source))))))

(ert-deftest codex-ide-search-cloned-results-keep-shared-snapshot-alive ()
  (let ((original (generate-new-buffer " *Codex original test*")) clone source)
    (unwind-protect
        (progn
          (with-current-buffer original
            (codex-ide-search-mode)
            (codex-ide-search--insert-result (codex-ide-search-test--hit))
            (setq source (cdar codex-ide-search--source-buffers))
            (setq clone (clone-buffer " *Codex cloned test*" nil)))
          (kill-buffer original)
          (should (buffer-live-p source))
          (with-current-buffer clone
            (goto-char (point-min))
            (should (eq source (marker-buffer (occur-mode-find-occurrence)))))
          (kill-buffer clone)
          (should-not (buffer-live-p source)))
      (dolist (buffer (list original clone source))
        (when (buffer-live-p buffer) (kill-buffer buffer))))))

(ert-deftest codex-ide-search-renames-results-not-an-unrelated-occur-buffer ()
  (with-temp-buffer
    (codex-ide-search-mode)
    (let ((original-name (buffer-name))
          (new-name (generate-new-buffer-name "*Codex renamed test*")))
      (unwind-protect
          (cl-letf (((symbol-function 'read-string) (lambda (&rest _) new-name)))
            (call-interactively (key-binding (kbd "r")))
            (should (equal (buffer-name) new-name)))
        (rename-buffer original-name t)))))

(ert-deftest codex-ide-search-preview-uses-native-chrome-with-exact-source-offsets ()
  (let* ((user "  > user **raw**\n\n\tλ MATCH  ")
         (assistant "# Heading\n**bold** `code`\n| λ | MATCH |\n| - | - |\n")
         (hit (codex-ide-search--make-hit
               :thread '((id . "native-preview")) :directory "/project/"
               :messages (list (cons 'user user) (cons 'assistant assistant))
               :message-index 1 :offset (string-match "MATCH" assistant) :query "MATCH")))
    (with-temp-buffer
      (let ((buffer (current-buffer)))
        (cl-letf (((symbol-function 'codex-ide--show-or-resume-thread)
                   (lambda (&rest _) (ert-fail "Preview resumed a session")))
                  ((symbol-function 'codex-ide--read-thread)
                   (lambda (&rest _) (ert-fail "Preview fetched history"))))
          (codex-ide-search--preview-buffer hit buffer))
        (should (derived-mode-p 'codex-ide-search-preview-mode))
        (should buffer-read-only)
        (should visual-line-mode)
        (should (looking-at "MATCH"))
        (cl-loop for text in (list user assistant) for index from 0
                 for start = (aref codex-ide-search--message-starts index) do
                 (should (equal text (buffer-substring-no-properties
                                      start (+ start (length text))))))
        (should (text-property-any (point-min) (point-max)
                                   'face 'codex-ide-user-prompt-face))
        (should (eq (key-binding (kbd "C-c C-r")) #'codex-ide-search-resume))))))

(ert-deftest codex-ide-search-secondary-selection-validates-the-current-candidate ()
  (let* ((first (codex-ide-search-test--hit "first"))
         (second (codex-ide-search-test--hit "second"))
         (codex-ide-search--consult-candidates
          (codex-ide-search--candidates (list first second)))
         (codex-ide-search--consult-action nil)
         (chosen (propertize (caadr codex-ide-search--consult-candidates) 'face 'bold))
         (consult--completion-candidate-hook (list (lambda () chosen)))
         exited)
    (with-temp-buffer
      (insert "fuzzy query")
      (cl-letf (((symbol-function 'minibufferp) (lambda (&rest _) t))
                ((symbol-function 'delete-minibuffer-contents) #'erase-buffer)
                ((symbol-function 'exit-minibuffer) (lambda () (setq exited t))))
        (call-interactively #'codex-ide-search-consult-resume))
      (should exited)
      (should (eq codex-ide-search--consult-action 'resume))
      (should (equal (buffer-string) (substring-no-properties chosen))))))

(ert-deftest codex-ide-search-secondary-selection-never-guesses-on-zero-matches ()
  (let ((codex-ide-search--consult-candidates
         (codex-ide-search--candidates (list (codex-ide-search-test--hit))))
        (codex-ide-search--consult-action nil))
    (dolist (input '(nil "does not match"))
      (let ((consult--completion-candidate-hook (list (lambda () input))))
        (cl-letf (((symbol-function 'minibufferp) (lambda (&rest _) t))
                  ((symbol-function 'exit-minibuffer)
                   (lambda () (ert-fail "Exited without a valid selection"))))
          (should-error (codex-ide-search-consult-resume) :type 'user-error)
          (should-not codex-ide-search--consult-action))))))

(ert-deftest codex-ide-search-secondary-selection-opens-only-after-preview-cleanup ()
  ;; The selected hit must not depend on preview being enabled, nor on which
  ;; hit was most recently previewed.
  (dolist (preview-enabled '(nil t))
    (save-window-excursion
      (let ((first (codex-ide-search-test--hit "first"))
            (second (codex-ide-search-test--hit "second"))
            (origin (window-buffer))
            (session (generate-new-buffer " *Codex session test*"))
            preview resumed)
        (unwind-protect
            (cl-letf (((symbol-function 'consult--state-with-return)
                       #'codex-ide-search-test--compose-state)
                      ((symbol-function 'consult--read)
                       (lambda (table &rest options)
                         (let* ((state (plist-get options :state))
                                (consult--completion-candidate-hook
                                 (list (lambda () (cadr table)))))
                           (when preview-enabled
                             (funcall state 'preview first)
                             (setq preview (current-buffer)))
                           (should (eq (lookup-key (plist-get options :keymap)
                                                   (kbd "C-c C-r"))
                                       #'codex-ide-search-consult-resume))
                           (catch 'selected
                             (with-temp-buffer
                               (cl-letf (((symbol-function 'minibufferp)
                                          (lambda (&rest _) t))
                                         ((symbol-function 'delete-minibuffer-contents)
                                          #'erase-buffer)
                                         ((symbol-function 'exit-minibuffer)
                                          (lambda () (throw 'selected t))))
                                 (codex-ide-search-consult-resume))))
                           (funcall state 'exit nil)
                           (funcall state 'return second)
                           second)))
                      ((symbol-function 'codex-ide-search--resume-hit)
                       (lambda (hit)
                         (should (eq hit second))
                         (should-not (buffer-live-p preview))
                         (should (eq (window-buffer) origin))
                         (setq resumed t)
                         (switch-to-buffer session))))
              (codex-ide-search--consult-read (list first second) nil 0)
              (should resumed)
              (should (eq (window-buffer) session)))
          (when (buffer-live-p preview) (kill-buffer preview))
          (kill-buffer session))))))

(ert-deftest codex-ide-search-aborted-secondary-selection-does-not-resume ()
  (save-window-excursion
    (let ((origin (window-buffer)))
      (cl-letf (((symbol-function 'consult--state-with-return)
                 #'codex-ide-search-test--compose-state)
                ((symbol-function 'consult--read)
                 (lambda (&rest _)
                   (setq codex-ide-search--consult-action 'resume)
                   (signal 'quit nil)))
                ((symbol-function 'codex-ide-search--resume-hit)
                 (lambda (&rest _) (ert-fail "Resume on abort"))))
        (should (condition-case nil
                    (progn (codex-ide-search--consult-read
                            (list (codex-ide-search-test--hit)) nil 0) nil)
                  (quit t))))
      (should (eq (window-buffer) origin)))))

