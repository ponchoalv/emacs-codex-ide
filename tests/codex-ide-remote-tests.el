(ert-deftest codex-ide-remote-unexpected-disconnect-no-recovery-or-restart ()
  (codex-ide-remote-test--processes
    (let* ((session (make-codex-ide-session :process 'client :query-only t
                                            :pending-requests (make-hash-table)))
           status cleaned)
      (process-put 'client 'codex-session session)
      (process-put 'client 'codex-ws-ready t)
      (push 'client closed)
      (cl-letf (((symbol-function 'codex-ide--set-session-status)
                 (lambda (_ value &rest _) (setq status value)))
                ((symbol-function 'codex-ide--update-header-line) #'ignore)
                ((symbol-function 'codex-ide-log-message) #'ignore)
                ((symbol-function 'codex-ide--cleanup-session) (lambda (_) (setq cleaned t)))
                ((symbol-function 'codex-ide--recover-from-session-error)
                 (lambda (&rest _) (ert-fail "Shared daemon recovery attempted"))))
        (codex-ide--process-sentinel 'client "connection broken")
        (should (equal status "disconnected"))
        (should cleaned)))))

