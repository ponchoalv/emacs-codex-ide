    (process-put 'client 'codex-ws-ready t)
    (process-put 'client 'codex-ws-filter (lambda (&rest _) (ert-fail "Truncation delivered")))
    (codex-ide-remote--filter 'client (unibyte-string 1 1 226))
    (should-not closed)
    (codex-ide-remote--filter 'client (unibyte-string 128 0))
    (should (process-get 'client 'codex-ws-error))))

(ert-deftest codex-ide-remote-close-validates-and-acknowledges-before-disconnect ()
  (dolist (payload (list "" (unibyte-string 3 232)
                        (concat (unibyte-string 3 233) (encode-coding-string "bye ☃" 'utf-8-unix))
                        (unibyte-string 15 160)))
    (codex-ide-remote-test--processes
      (process-put 'client 'codex-ws-ready t)
      (cl-letf (((symbol-function 'process-send-string)
                 (lambda (_p data)
                   (should-not closed)
                   (push data sent))))
        (codex-ide-remote--filter 'client (concat (unibyte-string 136 (length payload)) payload)))
      (should (memq 'client closed))
      (should-not (process-get 'client 'codex-ws-error))
      (should (= (length sent) 1))
      (let ((reply (car sent)))
        (should (= (aref reply 0) 136))
        (should (= (aref reply 1) (+ 128 (length payload))))
        (should (equal (apply #'unibyte-string
                               (cl-loop for i below (length payload)
                                        collect (logxor (aref reply (+ 6 i))
                                                        (aref reply (+ 2 (% i 4))))))
                       payload))))))

(ert-deftest codex-ide-remote-close-rejects-invalid-payloads ()
  (dolist (payload (append
                   (list (unibyte-string 0)
                         (unibyte-string 3 232 255)
                         (unibyte-string 3 232 192 175)
                         (unibyte-string 3 232 226 130))
                   (mapcar (lambda (code) (unibyte-string (ash code -8) (logand code 255)))
                           '(0 999 1004 1005 1006 1015 1016 2000 2999 5000))))
    (codex-ide-remote-test--processes
      (process-put 'client 'codex-ws-ready t)
      (codex-ide-remote--filter 'client (concat (unibyte-string 136 (length payload)) payload))
      (should (memq 'client closed))
      (should (process-get 'client 'codex-ws-error))
      (should-not sent))))

(ert-deftest codex-ide-remote-connect-resolves-short-endpoint-retains-path-identity ()
  (codex-ide-remote-test--processes
    (let* ((process-environment (copy-sequence process-environment))
           (codex-ide-shared-socket-path nil)
           (home (concat "/tmp/" (make-string 180 ?a)))
           (path (expand-file-name "app-server-control/app-server-control.sock" home))
           service)
      (setenv "CODEX_HOME" home)
      (cl-letf (((symbol-function 'file-directory-p) (lambda (_) t))
                ((symbol-function 'file-truename)
                 (lambda (name) (if (equal name path) "/tmp/short.sock" name)))
                ((symbol-function 'make-network-process)
                 (lambda (&rest args) (setq service (plist-get args :service)) 'client))
                ((symbol-function 'set-process-sentinel) #'ignore)
                ((symbol-function 'accept-process-output)
                 (lambda (&rest _) (process-put 'client 'codex-ws-ready t))))
        (should (eq (codex-ide-remote--connect :name "test" :filter #'ignore :sentinel #'ignore)
                    'client))
        (should (equal service "/tmp/short.sock"))
        (should (equal (process-get 'client 'codex-ws-socket) path))))))

(ert-deftest codex-ide-remote-connect-rejects-remote-endpoint ()
  (codex-ide-remote-test--processes
    (let ((codex-ide-shared-socket-path "/tmp/test.sock"))
      (cl-letf (((symbol-function 'file-truename) (lambda (_) "/ssh:host:/tmp/socket"))
                ((symbol-function 'make-network-process)
                 (lambda (&rest _) (ert-fail "Remote endpoint accepted"))))
        (should-error (codex-ide-remote--connect :name "test" :filter #'ignore :sentinel #'ignore)
                      :type 'user-error)))))

