(ert-deftest codex-ide-remote-reentrant-delivery-preserves-buffered-and-partial-frames ()
  ;; Nested input may complete an already buffered frame, or leave one partial.
  (dolist (partial '(nil t))
    (codex-ide-remote-test--processes
      (let (received)
        (process-put 'client 'codex-ws-ready t)
        (process-put 'client 'codex-ws-filter
                     (lambda (_p text)
                       (push text received)
                       (when (equal text "A\n")
                         (should (equal (process-get 'client 'codex-ws-bytes)
                                        (if partial (unibyte-string 129) "")))
                         (should-not (process-get 'client 'codex-ws-fragment))
                         (codex-ide-remote--filter
                          'client (if partial (unibyte-string 1)
                                    (unibyte-string 129 1 ?B)))
                         (should (equal received '("A\n"))))))
        (codex-ide-remote--filter
         'client (concat (unibyte-string 1 1 ?A 128 0)
                         (if partial (unibyte-string 129) "")))
        (when partial
          (should (equal (process-get 'client 'codex-ws-bytes)
                         (unibyte-string 129 1)))
          (codex-ide-remote--filter 'client (unibyte-string ?B)))
        (should (equal (reverse received) '("A\n" "B\n")))
        (should (equal (process-get 'client 'codex-ws-bytes) ""))
        (should-not closed)))))

(ert-deftest codex-ide-remote-reentrant-delivery-preserves-coalesced-frames ()
