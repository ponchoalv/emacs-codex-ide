(ert-deftest codex-ide-remote-websocket-masked-send-and-stdio-routing ()
  (codex-ide-remote-test--processes
    (cl-letf (((symbol-function 'codex-ide-remote--bytes) (lambda (_) (unibyte-string 1 2 3 4))))
      (codex-ide-remote--send-frame 'client 1 "hello")
      (let ((frame (car sent)))
        (should (= (aref frame 0) 129))
        (should (= (aref frame 1) 133))
        (should (equal (cl-loop for i from 6 below (length frame)
                               collect (logxor (aref frame i) (aref frame (+ 2 (% (- i 6) 4)))))
                       (string-to-list "hello")))))
    (let* ((session (make-codex-ide-session :process 'client)) called)
      (codex-ide-remote--jsonrpc-send (lambda (&rest _) (setq called t)) session '((method . "test")))
      (should called)
      (setq called nil)
      (process-put 'client 'codex-ws-ready t)
      (codex-ide-remote--jsonrpc-send (lambda (&rest _) (setq called t)) session '((method . "test")))
      (should-not called)
      (push 'client closed)
      (should-error (codex-ide-remote--jsonrpc-send #'ignore session nil)))))

(ert-deftest codex-ide-remote-websocket-streaming-fragments-ping-and-close ()
  (codex-ide-remote-test--processes
    (let (received)
      (process-put 'client 'codex-ws-ready t)
      (process-put 'client 'codex-ws-filter (lambda (_p text) (push text received)))
      (codex-ide-remote--filter 'client (unibyte-string 1))
      (codex-ide-remote--filter 'client (concat (unibyte-string 2) "he" (unibyte-string 137 1) "?"))
      (should-not received)
      (should sent) ; ping was answered while text message was fragmented
      (codex-ide-remote--filter 'client (concat (unibyte-string 128 3) "llo"))
      (should (equal received '("hello\n")))
      (codex-ide-remote--filter 'client (unibyte-string 136 0))
      (should (memq 'client closed)))))

(ert-deftest codex-ide-remote-websocket-invalid-frames-fail-closed ()
  (dolist (frame (list (unibyte-string 193 0) ; RSV/compression not negotiated
                       (unibyte-string 129 128) ; masked server frame
                       (unibyte-string 128 0) ; continuation without fragment
                       (unibyte-string 2 0) ; binary
                       (unibyte-string 137 126 0 126)))
    (codex-ide-remote-test--processes
      (process-put 'client 'codex-ws-ready t)
      (codex-ide-remote--filter 'client frame)
      ;; Incomplete ping waits for its payload before validating.
      (when (= (length frame) 4)
        (codex-ide-remote--filter 'client (make-string 126 0)))
      (should (memq 'client closed))
      (should (process-get 'client 'codex-ws-error)))))

(ert-deftest codex-ide-remote-connect-upgrades-local-network-only ()
  (codex-ide-remote-test--processes
    (let ((codex-ide-shared-socket-path "/tmp/test.sock") args sentinel)
      (cl-letf (((symbol-function 'make-network-process)
                 (lambda (&rest options) (setq args options) 'client))
                ((symbol-function 'set-process-sentinel)
                 (lambda (_p fn) (setq sentinel fn)))
                ((symbol-function 'accept-process-output)
                 (lambda (&rest _)
                   (codex-ide-remote--filter
                    'client (concat "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\n"
                                    "Connection: Upgrade\r\nSec-WebSocket-Accept: "
                                    (process-get 'client 'codex-ws-accept) "\r\n\r\n")))))
        (should (eq (codex-ide-remote--connect :name "test" :filter #'ignore :sentinel #'ignore) 'client))
        (should (eq (plist-get args :family) 'local))
        (should (equal (plist-get args :service) (file-truename "/tmp/test.sock")))
        (should (eq sentinel #'ignore))
        (should (process-get 'client 'codex-ws-ready))
        (should (string-match-p "GET / HTTP/1.1" (car sent)))))))

