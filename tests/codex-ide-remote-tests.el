(ert-deftest codex-ide-remote-disconnect-and-sentinel-guards ()
  (codex-ide-remote-test--processes
    (let* ((pending (make-hash-table))
           (session (make-codex-ide-session :process 'client :pending-requests pending))
           (cleanup 0) response)
      (process-put 'client 'codex-session session)
      (puthash 1 (lambda (_result error) (setq response error)) pending)
      (cl-letf (((symbol-function 'codex-ide--cleanup-session) (lambda (_) (cl-incf cleanup)))
                ((symbol-function 'codex-ide--render-session-error) (lambda (&rest _) (ert-fail "Intentional close rendered error"))))
        (codex-ide--disconnect-process 'client)
        (should (process-get 'client 'codex-ide-disconnecting))
        (codex-ide--process-sentinel 'client "deleted")
        (should (equal (alist-get 'message response) "Codex connection closed"))
        (should (= (hash-table-count pending) 0))
        (codex-ide--process-sentinel 'client "deleted again")
        (should (= cleanup 1))
        (process-put 'obsolete 'codex-session session)
        (codex-ide--process-sentinel 'obsolete "closed")
        (should (= cleanup 1))))))

