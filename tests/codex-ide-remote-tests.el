;;; codex-ide-remote-tests.el --- Remote and shared transport tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'codex-ide)
(require 'codex-ide-remote)

(defmacro codex-ide-remote-test--processes (&rest body)
  "Run BODY with entirely mocked process I/O."
  (declare (indent 0))
  `(let ((properties (make-hash-table :test 'equal))
         (native-comp-enable-subr-trampolines nil) sent closed)
     (cl-letf (((symbol-function 'process-get)
                (lambda (p key) (gethash (list p key) properties)))
               ((symbol-function 'process-put)
                (lambda (p key value) (puthash (list p key) value properties)))
               ((symbol-function 'process-live-p)
                (lambda (p) (and p (not (memq p closed)))))
               ((symbol-function 'process-send-string)
                (lambda (_p data) (push data sent)))
               ((symbol-function 'delete-process)
                (lambda (p) (push p closed))))
       ,@body)))

(ert-deftest codex-ide-remote-cli-explicit-json-and-private-errors ()
  (let ((codex-ide-cli-path "/mock/codex") args)
    (cl-letf (((symbol-function 'call-process)
               (lambda (&rest values)
                 (setq args values)
                 (insert "{\"status\":\"stopped\"}") 0)))
      (should (equal (codex-ide-remote--cli "stop") '((status . "stopped")))))
    (should (equal args '("/mock/codex" nil (t t) nil "remote-control" "stop" "--json")))
    (dolist (status '(1 "killed" 0))
      (cl-letf (((symbol-function 'call-process)
                 (lambda (&rest _) (insert "SECRET-CODE token=SECRET") status)))
        (let ((error (should-error (codex-ide-remote--cli "pair") :type 'user-error)))
          (should-not (string-match-p "SECRET" (error-message-string error))))))
    (cl-letf (((symbol-function 'call-process) (lambda (&rest _) (signal 'file-missing '("secret")))))
      (should-error (codex-ide-remote--cli "start") :type 'user-error))))

(ert-deftest codex-ide-remote-commands-private-stdio-and-stop-confirmation ()
  (let ((codex-ide-transport 'stdio) called)
    (cl-letf (((symbol-function 'codex-ide-remote--cli) (lambda (_) (setq called t)))
              ((symbol-function 'yes-or-no-p) (lambda (_) nil)))
      (should-error (codex-ide-remote-control-start) :type 'user-error)
      (should-error (codex-ide-remote-control-pair) :type 'user-error)
      (codex-ide-remote-control-stop)
      (should-not called)))
  (let (operation)
    (cl-letf (((symbol-function 'yes-or-no-p) (lambda (_) t))
              ((symbol-function 'codex-ide-remote--cli)
               (lambda (op) (setq operation op) '((status . "notRunning")))))
      (codex-ide-remote-control-stop)
      (should (equal operation "stop")))))

(ert-deftest codex-ide-remote-pair-shows-only-manual-code-and-expiry ()
  (let ((codex-ide-transport 'shared) (codex-ide-shared-socket-path nil)
        messages timer-target)
    (unwind-protect
        (cl-letf (((symbol-function 'codex-ide-remote--cli)
                   (lambda (op)
                     (should (equal op "pair"))
                     `((pairingCode . "SECRET-TOKEN") (manualPairingCode . "ABCD-EFGH")
                       (expiresAt . ,(+ 60 (floor (float-time)))))))
                  ((symbol-function 'display-buffer) #'ignore)
                  ((symbol-function 'message) (lambda (&rest args) (push args messages)))
                  ((symbol-function 'run-at-time)
                   (lambda (_time _repeat callback target)
                     (setq timer-target (cons callback target)))))
          (codex-ide-remote-control-pair)
          (with-current-buffer "*Codex pairing*"
            (should (string-match-p "ABCD-EFGH" (buffer-string)))
            (should (string-match-p "Expires:" (buffer-string)))
            (should-not (string-match-p "SECRET-TOKEN" (buffer-string)))
            (should (eq buffer-undo-list t)))
          (should-not (string-match-p "ABCD-EFGH\\|SECRET-TOKEN" (prin1-to-string messages)))
          (funcall (car timer-target) (cdr timer-target))
          (should-not (get-buffer "*Codex pairing*")))
      (when (get-buffer "*Codex pairing*") (kill-buffer "*Codex pairing*")))))

